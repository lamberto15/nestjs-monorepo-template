# The context of caddy/Dockerfile is the repository root: only the web app's
# build goes in, with what it depends on. (apps/api/package.json: the
# lockfile lists the API as a project, so pnpm needs it.)
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!patches
!apps/api/package.json
# The forms' contract test (apps/web/src/features/forms/rules.test.ts) type-checks
# the web app's mirror against the API's evaluator, a file without imports.
!apps/api/src/platform/forms/form-rules.ts
!apps/web
!packages/api-client
!packages/ui
!caddy/entrypoint.sh
!caddy/maintenance.html
**/node_modules
**/dist
**/.turbo
**/*.tsbuildinfo
**/.env*
