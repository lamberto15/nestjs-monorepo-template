{
	email {env.ACME_EMAIL}
	# No autosave.json in the caddy_config volume: the configuration (the
	# Cloudflare token's placeholder with it) is this file, read at each start.
	persist_config off
	# Tenants' custom domains (CUSTOM_DOMAINS, docs/branding.md, "Custom
	# domains"): the site at the end gets a hostname's certificate when it is
	# first reached (HTTP-01 or TLS-ALPN-01), only once the API says the
	# hostname is a verified domain of an active tenant; else the handshake
	# fails and nothing is issued. Caddy appends ?domain=<hostname>.
	on_demand_tls {
		ask http://api:3000/v1/internal/domains/allowed
	}
}

# What every site serves: the API's paths and the web app. Imported by the
# app's own domain and by the tenants' custom domains below.
(app) {
	# Prometheus scrapes /metrics inside the Compose network (api:3000): never from outside.
	# Path matchers ignore case (/METRICS too) and /metrics* covers /metrics/ as well.
	# A handle of its own: the web app's catch-all below would answer it otherwise.
	handle /metrics* {
		respond 404
	}

	# The edge's own questions to the API (the custom domains' TLS ask): asked
	# on the private network (api:3000), never from outside.
	handle /v1/internal/* {
		respond 404
	}

	# RFC 9116 security.txt: a static file, written at each start by
	# caddy/entrypoint.sh from SECURITY_* (no file without SECURITY_CONTACT: 404).
	# Its own handle, before @api: @api takes every /.well-known/* path, and
	# the API serves no files of its own here (the REST-only rule holds).
	handle /.well-known/security.txt {
		root * /tmp/caddy-security
		file_server
	}

	# The API's paths (versioned routes, realtime, health, Swagger UI and its
	# document, stored files, .well-known); every other path is the web app.
	# Exact segments, no bare prefixes: /api* would also take the app's /api-keys.
	# /files and /files/*: the local disk's signed links are /files?key=…&signature=…,
	# whose path is /files itself, which /files/* does not match. Left out, a download
	# (an issued PDF, an export, an attachment) is the web app's index.html, 200.
	# No `encode` here: the API's responses pass as the API sends them. Caddy's
	# encode turns a strong ETag into "<tag>-gzip" and takes the suffix off the
	# If-None-Match a read sends back, but not off the If-Match of a write
	# (docs/api-conventions.md, "Concurrency and caching"); and in the Helm
	# chart the Ingress sends these paths past Caddy. Compressing the API is
	# the API's own decision, for every deployment at once. The ops log's
	# text/event-stream (GET /v1/ops/events) is flushed as it comes: Caddy does
	# that for the type by itself (reverse_proxy docs, flush_interval), so no
	# flush_interval is set (caddy/caddyfile.test.mjs checks both).
	@api path /v1/* /socket.io/* /health /health/* /api /api/* /api-json /api-yaml /files /files/* /.well-known/*
	handle @api {
		# Every api replica (API_REPLICAS): Docker's DNS lists them under "api".
		reverse_proxy {
			dynamic a {
				name api
				port 3000
				refresh 5s
			}
			# socket.io's long-polling needs one replica per client: a cookie keeps it there.
			lb_policy cookie lb_replica
			# A deploy recreates the replicas and none answers for 30-60 s: hold the
			# request and try again every 250 ms (for up to 30 s) instead of
			# answering 503 at once. The replicas are chosen anew at each try, so a
			# request pinned (cookie) to a replica that is gone falls over to a live
			# one. No lb_retries: a count would cap the tries (2 at 250 ms is 0.5 s)
			# before the duration does. A connection that fails is always retried;
			# once connected, only GET requests are (lb_retry_match).
			lb_try_duration 30s
			lb_try_interval 250ms
			# A replica that stops answering (or shuts down) is skipped for a while.
			fail_duration 10s
			# No active health checks: Caddy doesn't run them for dynamic upstreams
			# (reverse_proxy docs, "Dynamic upstreams"); the passive fail_duration
			# and lb_try_duration above do that work.
		}
	}

	# The web app (apps/web, built into /srv/web by caddy/Dockerfile): files
	# by path, index.html for the app's own routes.
	handle {
		root * /srv/web
		# Security headers of the web app only: the API's responses (the @api
		# block above) carry their own, from helmet. Extending the policy: docs/deployment.md.
		header {
			# Turnstile (challenges.cloudflare.com) is the only third party: its
			# script, and its iframe. Everything else is this origin: socket.io's
			# ws/wss included ('self' covers it in current browsers; Safari
			# before 15.4 didn't, and no template target is that old).
			# img-src's blob: is the queued-upload preview (packages/ui's
			# FileUpload): the browser's own object URL for a file not yet sent,
			# never fetched over the network. connect-src and img-src also take
			# WEB_FILES_ORIGINS, the origins the browser reaches for files: with
			# STORAGE_DRIVER=s3 it PUTs a direct upload to the bucket, and an
			# <img> follows an attachment's thumbnail to the bucket's signed link
			# (docs/attachments.md, "Direct uploads", "Image renditions").
			# caddy/entrypoint.sh makes that list at each start
			# (the bucket's origin from the S3 settings, then FILES_ORIGIN's) and
			# exports it to this process. {env.*} is read by the running Caddy, so
			# a `caddy reload` from a shell that lacks it keeps the list; empty or
			# unset adds nothing.
			# style-src keeps 'unsafe-inline': sonner and the theme provider inject
			# <style> elements at runtime (checked in the browser; without it the
			# page logs violations). No 'unsafe-eval': apps/web/src/lib/zod.ts sets zod to jitless.
			Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' {env.WEB_FILES_ORIGINS}; img-src 'self' data: blob: {env.WEB_FILES_ORIGINS}; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
			# frame-ancestors' older twin, for browsers that predate CSP level 2.
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			# WebAuthn (publickey-credentials-*) stays on for this origin; the rest is off.
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), publickey-credentials-get=(self), publickey-credentials-create=(self)"
			# HTTPS only, for two years, every subdomain included: matches the
			# API's own (helmet, core/http/http-setup.ts) — this deployment
			# serves every subdomain under APP_DOMAIN over HTTPS only. No
			# preload: that submits the domain to browsers' built-in list, a
			# step this app doesn't take for the owner.
			Strict-Transport-Security "max-age=63072000; includeSubDomains"
			# A page of another origin that opens this one, or that this one
			# opens, gets no handle on its window (window.opener): the app needs
			# none (sign-in providers are full-page redirects, Turnstile is an
			# iframe, its links out are noopener, the tabs talk over
			# BroadcastChannel).
			Cross-Origin-Opener-Policy "same-origin"
		}
		# Compressed for the browser: the files under /assets/* when the image
		# is built (a .br and a .gz beside each, apps/web/scripts/precompress.mjs,
		# which `precompressed` below sends: browsers take one, so nothing is
		# compressed per request), the rest (index.html, version.json, the
		# service worker, the manifest, the maintenance page) as it is sent,
		# zstd or gzip (Caddy has no brotli encoder). Under 512 bytes, a
		# response is sent as it is.
		encode zstd gzip
		# Maintenance (MAINTENANCE_PAGE=on, docs/deployment.md, "Maintenance
		# page"): every path of the web app answers the static page, 503 with
		# Retry-After, so neither the shell nor its files are served. The API's
		# paths (the @api handle above) are not touched: they answer for
		# themselves, 503 `maintenance` while APP_MODE says so. {env.*} is read
		# at each request, so an unset or any other value is "off". Written
		# first in this block: a handle with a single path (/assets/* below)
		# would otherwise be sorted before it (Caddyfile directives, "Sorting
		# algorithm"; a named matcher keeps its place).
		@maintenance expression {env.MAINTENANCE_PAGE} == "on"
		handle @maintenance {
			root * /srv/maintenance
			header Cache-Control "no-store"
			header Retry-After "30"
			rewrite * /index.html
			file_server {
				status 503
			}
		}
		handle /version.json {
			header Cache-Control "no-store"
			file_server
		}
		# Hashed file names: they never change. A missing one is a 404, not the page.
		handle /assets/* {
			# Only a file that exists: a 404 must not be cached for a year.
			@asset file
			header @asset Cache-Control "public, max-age=31536000, immutable"
			# The .br, else the .gz, beside the file when the browser takes it
			# (Content-Encoding and Vary set by file_server); without one, the file.
			file_server {
				precompressed br gzip
			}
		}
		# index.html names the current assets: always fetched again.
		handle {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}

{$APP_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		# check TXT propagation via public DNS, not the private network resolver
		resolvers 1.1.1.1 1.0.0.1
	}
	import app
}

# Tenants' custom domains: any other hostname, its certificate on demand
# (the global on_demand_tls above). Each request asks the API again first, so
# a domain removed or suspended stops at once, though its certificate is
# still cached: the API answers 200 for a verified domain, else 404, which is
# returned as it is. CUSTOM_DOMAINS=off: every answer is 404, nothing is issued.
https:// {
	tls {
		on_demand
	}
	forward_auth api:3000 {
		uri /v1/internal/domains/allowed?domain={host}
		# A deploy recreates the replicas: hold the request as @api does.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
	import app
}
