# Copy to .env.development (cp env.development.example .env.development) to run the app against
# `pnpm services:up` (PostgreSQL and Redis are required). The Redis
# on localhost:6379, and writes mails to .data/mail.

# Development, said explicitly: the demo seed (pnpm db:seed:demo) runs only
# where NODE_ENV is set to development (unset, the app assumes it, the seed doesn't).
NODE_ENV=development

# Two roles, as in production (docs/deployment.md, "Database roles"): the app
# connects as app_runtime, which the startup migration (MIGRATE_ON_START, on
# here) creates from this URL; the migration itself runs as the owner, the
# `app` user `pnpm services:up` made (dev/compose.env).
DATABASE_URL=postgres://app_runtime:app_runtime@127.0.0.1:5432/app
DATABASE_OWNER_URL=postgres://app:app@127.0.0.1:5432/app
# The maintenance role (BYPASSRLS, docs/tenancy.md "The bypass"): the startup
# migration makes it too; the workers' sweeps across tenants connect as it.
DATABASE_MAINTENANCE_URL=postgres://app_maintenance:app_maintenance@127.0.0.1:5432/app
REDIS_URL=redis://127.0.0.1:6379
# The web app you develop next to the API (CORS, the links in emails)
WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Plain http://localhost: browsers accept Secure cookies there, so leave it on
SESSION_COOKIE_SECURE=on
AUTH_SIGN_UP=on
# multi, or single (docs/tenancy.md, "Single-tenant deployments"; the demo seed needs multi).
TENANCY=multi
# New passwords are checked against Pwned Passwords (on); offline, a check
# waits PASSWORD_BREACH_TIMEOUT_MS and lets the password through. Or turn it off:
# PASSWORD_BREACH_CHECK=off
# Bot protection is off (docs/auth.md, "Bot protection"). To try the flow
# without a Cloudflare account: CAPTCHA_MODE=always CAPTCHA_PROVIDER=stub and
# send `X-Captcha-Token: stub:pass:<anything unique>`; with Turnstile's test
# keys (its docs, "Testing"), CAPTCHA_PROVIDER=turnstile and both keys.
# CAPTCHA_MODE=off
LOG_LEVEL=debug

# NestJS Observe (traces, metrics, errors), off when empty: the application's
# keys from its project's API keys page.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Files on S3 and mail through SES, both Floci's (http://localhost:4566): the
# production code paths. Every mail still lands in Mailpit: http://localhost:8025
STORAGE_DRIVER=s3
S3_BUCKET=app-files
S3_ENDPOINT=http://127.0.0.1:4566
S3_FORCE_PATH_STYLE=on
MAIL_TRANSPORT=ses
MAIL_FROM=My API <no-reply@example.com>
SES_ENDPOINT=http://127.0.0.1:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Not deploying to AWS? Mail straight to Mailpit, files on the local disk:
# MAIL_TRANSPORT=smtp
# SMTP_URL=smtp://127.0.0.1:1025
# STORAGE_DRIVER=local

# PDF documents (docs/documents.md): the Gotenberg `pnpm services:up` runs.
# Unset: documents are off (POST /v1/notes/{id}/pdf answers 503).
GOTENBERG_URL=http://127.0.0.1:3100
