{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "i18n/**/*.json",
        "watchAssets": true
      },
      {
        "include": "**/mail/templates/**/*.html",
        "watchAssets": true
      },
      {
        "include": "documents/templates/**/*.html",
        "watchAssets": true
      }
    ]
  }
}
