        "using": "((\"attachment_uploads\".\"tenant_id\" = any((select string_to_array(coalesce(current_setting('app.read_tenants', true), ''), ',')::uuid[])::uuid[]) and (\"attachment_uploads\".\"tenant_id\" = (select nullif(current_setting('app.tenant_id', true), '')::uuid) or \"attachment_uploads\".\"tenant_id\" = any(array(select \"tenant_closure\".\"descendant_id\" from \"tenant_closure\" where \"tenant_closure\".\"ancestor_id\" = (select nullif(current_setting('app.tenant_id', true), '')::uuid))))))",
