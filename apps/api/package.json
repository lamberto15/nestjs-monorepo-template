{
  "name": "@nestjs-monorepo-template/api",
  "version": "0.0.1",
  "description": "The NestJS API: HTTP, WebSockets and the workers (one image, three commands: node dist/main, dist/worker, dist/migrate).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "migrate": "node dist/migrate",
    "openapi:dump": "nest build && node dist/openapi-dump"
  },
  "dependencies": {
    "@casl/ability": "^7.0.1",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "2.0.1",
    "@nestjs/authentication": "^0.1.1",
    "@nestjs/authorization": "^0.1.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/http-client": "^0.0.2",
    "@nestjs/i18n": "^0.0.1",
    "@nestjs/idempotency": "^0.0.2",
    "@nestjs/locks": "^0.0.3",
    "@nestjs/mail": "^0.0.1",
    "@nestjs/observe": "^0.3.10",
    "@nestjs/outbox": "^0.1.2",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/resilience": "^0.0.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/storage": "^0.0.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/webhooks": "^0.0.2",
    "@nestjs/websockets": "^12.1.3",
    "@nestjs/workflows": "^0.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@standard-schema/spec": "^1.1.0",
    "bullmq": "^6.3.14",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "nestjs-cls": "7.0.1",
    "pg": "^8.23.1",
    "prom-client": "15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs-monorepo-template/api-client": "workspace:*",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.4",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^5.0.4"
  }
}
