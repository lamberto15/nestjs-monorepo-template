{
  "name": "@nestjs-monorepo-template/api",
  "version": "0.0.1",
  "description": "The NestJS API: HTTP, WebSockets and the workers (one image, three commands: node dist/main, dist/worker, dist/migrate).",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:generate:fixtures": "drizzle-kit generate --config drizzle.fixtures.config.ts",
    "db:check": "drizzle-kit check && drizzle-kit check --config drizzle.fixtures.config.ts",
    "db:studio": "drizzle-kit studio",
    "migrate": "node dist/migrate",
    "db:seed:demo": "nest build && node dist/seed-demo",
    "ops": "nest build && node dist/cli",
    "openapi:dump": "nest build && node dist/openapi-dump"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@casl/ability": "7.0.2",
    "@nest-lab/throttler-storage-redis": "1.2.0",
    "@nestjs-cls/transactional": "4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "2.0.1",
    "@nestjs/authentication": "0.1.1",
    "@nestjs/authorization": "0.1.0",
    "@nestjs/bullmq": "12.0.0",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/drizzle": "0.0.2",
    "@nestjs/http-client": "0.0.2",
    "@nestjs/i18n": "0.0.1",
    "@nestjs/idempotency": "0.0.2",
    "@nestjs/locks": "0.0.4",
    "@nestjs/mail": "0.0.1",
    "@nestjs/observe": "0.3.17",
    "@nestjs/outbox": "0.1.3",
    "@nestjs/platform-node": "12.3.2",
    "@nestjs/platform-socket.io": "12.3.2",
    "@nestjs/resilience": "0.0.2",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/storage": "0.0.3",
    "@nestjs/swagger": "12.0.3",
    "@nestjs/terminus": "12.1.0",
