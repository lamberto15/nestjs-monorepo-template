[
  {
    "name": "Entry script (brotli)",
    "path": "dist/assets/index-*.js",
    "limit": "72 kB"
  },
  {
    "name": "Entry styles (brotli)",
    "path": "dist/assets/index-*.css",
    "limit": "22 kB"
  },
  {
    "name": "Application scripts (brotli; optional analytics engine separate)",
    "path": ["dist/assets/*.js", "!dist/assets/*duckdb*.js"],
    "limit": "1.1 MB"
  },
  {
    "name": "Optional analytics engine scripts (brotli)",
    "path": ["dist/assets/*duckdb*.js"],
    "limit": "360 kB"
  },
  {
    "name": "Optional analytics WebAssembly (uncompressed)",
    "path": ["dist/assets/*duckdb*.wasm"],
    "brotli": false,
    "limit": "80 MB"
  },
  {
    "name": "Optional analytics extensions, json and parquet (uncompressed; a browser fetches one platform's two)",
    "path": ["dist/duckdb-extensions/**/*.wasm"],
    "brotli": false,
    "limit": "8 MB"
  }
]
