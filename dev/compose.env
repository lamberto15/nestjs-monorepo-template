# Docker Compose's variables for the development services (pnpm services:up).
# Not .env: that is production's, with its secrets and its project name.
# These match .env.development (env.development.example).
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
S3_BUCKET=app-files
MAIL_FROM_ADDRESS=no-reply@example.com
