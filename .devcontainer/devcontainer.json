// A development container (https://containers.dev): Node.js and pnpm at the
// repository's versions, with PostgreSQL, Redis, Mailpit and Gotenberg beside
// it (compose.yaml here). docs/development.md, "Devcontainer".
{
  "name": "nestjs-monorepo-template",
  "dockerComposeFile": ["compose.yaml"],
  "service": "workspace",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  // The API (and Swagger UI at /api), and Mailpit's inbox.
  "forwardPorts": [3000, "mailpit:8025"],
  "portsAttributes": {
    "3000": { "label": "API" },
    "mailpit:8025": { "label": "Mailpit" }
  },
  // pnpm install, and apps/api/.env.development from its template when there is none.
  "postCreateCommand": "sh .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode", "oxc.oxc-vscode"]
    }
  }
}
