{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "ignorePatterns": [
    "packages/api-client/src/schema.ts",
    "apps/web/src/routeTree.gen.ts"
  ],
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["apps/web/src/**/*.{ts,tsx}", "packages/ui/src/**/*.{ts,tsx}"],
      "plugins": ["react", "typescript", "oxc"],
      "env": {
        "browser": true,
        "node": false
      },
      "rules": {
        "react/rules-of-hooks": "error",
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["apps/web/src/**/*.{ts,tsx}"],
      "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
      "rules": {
        // jsx-a11y (apps/web only; the rest of its rules stay on as warnings,
        // the ones that never fire are errors). Each rule below is off for a
        // deliberate pattern, not a finding:
        "jsx-a11y/alt-text": "error",
        "jsx-a11y/anchor-is-valid": "error",
        "jsx-a11y/aria-props": "error",
        "jsx-a11y/aria-role": "error",
        "jsx-a11y/click-events-have-key-events": "error",
        "jsx-a11y/label-has-associated-control": "error",
        "jsx-a11y/no-static-element-interactions": "error",
        // role="status" on a <p>/<div>/<Alert> is a live region with our own
        // styling; <output> is a form-result element, not a status message.
        // The same goes for the roles of Base UI parts and roving-focus lists.
        "jsx-a11y/prefer-tag-over-role": "off",
        // The first field of a dialog or of a sign-in step takes the focus on
        // purpose (the user just asked for it); WCAG 3.2.1 is about focus that
        // moves on its own on a page load, not a dialog the user opened.
        "jsx-a11y/no-autofocus": "off",
        // Base UI's `render={<a href />}` links get their text from the
        // Button's children (merged at render time); the rule sees an empty <a>.
        "jsx-a11y/control-has-associated-label": "off",
        // Roving-focus rows (the sort and filter menus) take the arrow keys on
        // a listitem; the keys move focus between the controls inside it.
        "jsx-a11y/no-noninteractive-element-interactions": "off",
        // A named scroll region takes tabIndex 0 so the keyboard can scroll it
        // (axe's scrollable-region-focusable asks for exactly this).
        "jsx-a11y/no-noninteractive-tabindex": "off"
      }
    },
    {
      "files": ["packages/ui/src/**"],
      "rules": {
        "react/set-state-in-effect": "off",
        "typescript/no-useless-default-assignment": "off",
        "typescript/no-floating-promises": "off"
      },
      "plugins": ["react", "typescript", "oxc"]
    },
    {
      "files": ["apps/web/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "zod",
                "message": "Import z from '@/lib/zod': it sets jitless before any schema exists (the CSP has no 'unsafe-eval')."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/**/*.controller.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-orm", "drizzle-orm/*"],
                "message": "Controllers do HTTP only: a service composes its query predicates (docs/architecture.md, 'Code style')."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/lib/zod.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
