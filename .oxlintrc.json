{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "ignorePatterns": [
    "packages/api-client/src/schema.ts",
    "apps/web/src/routeTree.gen.ts"
  ],
  "env": {
    "node": true
  },
  "overrides": [
    {
      "files": ["apps/web/src/**/*.{ts,tsx}", "packages/ui/src/**/*.{ts,tsx}"],
      "plugins": ["react", "typescript", "oxc"],
      "env": {
        "browser": true,
        "node": false
      },
      "rules": {
        "react/rules-of-hooks": "error",
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["packages/ui/src/**"],
      "rules": {
        "react/set-state-in-effect": "off",
        "typescript/no-useless-default-assignment": "off",
        "typescript/no-floating-promises": "off"
      },
      "plugins": ["react", "typescript", "oxc"]
    },
    {
      "files": ["apps/web/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "zod",
                "message": "Import z from '@/lib/zod': it sets jitless before any schema exists (the CSP has no 'unsafe-eval')."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/api/**/*.controller.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["drizzle-orm", "drizzle-orm/*"],
                "message": "Controllers do HTTP only: a service composes its query predicates (docs/architecture.md, 'Code style')."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/lib/zod.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
