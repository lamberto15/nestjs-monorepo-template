// knip: unused files, exports and dependencies (docs/development.md, "Dead
// code (knip)"). Workspaces (apps/*, packages/*) come from
// pnpm-workspace.yaml; each is listed here only to add what knip can't find
// or to ignore, with the reason.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // An export used only inside its own file is not reported (it may be
  // exported for nothing, but removing it changes nothing for importers).
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      // Node scripts run by hand or by CI, not imported.
      "entry": ["tools/**/*.mjs", "loadtest/*.{mjs,cjs,js}"],
      "project": ["tools/**/*.mjs", "loadtest/*.{mjs,cjs,js}"],
      // loadtest/scenarios.js imports k6's modules: k6 runs it in its own
      // container (loadtest/run.sh), it is not an npm dependency.
      // tools/setup/vapid.mjs loads the API's web-push (apps/api/package.json)
      // from the API's folder, for its key generator: the root does not
      // depend on it.
      "ignoreDependencies": ["k6", "web-push"],
    },
    "apps/api": {
      // Started as `node dist/<name>` (package.json: migrate, db:seed:demo,
      // openapi:dump, ops; the Docker image: worker) or by drizzle-kit.
      "entry": [
        "src/{worker,migrate,seed-demo,openapi-dump,cli}.ts",
        "src/demo/run-demo-seed.ts",
        "drizzle*.config.ts",
      ],
      // The global `Express.Multer.File` type of the upload interceptor.
      "ignoreDependencies": ["@types/multer"],
      // Started by test/global-setup.ts; CI and the devcontainer install it.
      "ignoreBinaries": ["redis-server"],
    },
    "apps/web": {
      // Dice UI's data table: registry output the shadcn CLI writes, kept
      // whole so `shadcn add` updates apply (CLAUDE.md: generate, never
      // hand-write). Parts of it are unused until a list page needs them.
      "ignore": ["src/components/data-table/**", "src/lib/data-table-*.ts"],
      // react-day-picker: the calendar of that same registry code.
      // tailwindcss: imported by the stylesheet (packages/ui), which
      // @tailwindcss/vite compiles; no JavaScript imports it.
      "ignoreDependencies": ["react-day-picker", "tailwindcss"],
    },
    "apps/web-e2e": {
      "entry": ["test/**/*.ts", "scripts/*.mjs"],
    },
    "packages/api-client": {
      // Generated by openapi-typescript (`pnpm client:generate`).
      "ignore": ["src/schema.ts"],
    },
  },
}
