{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "globalDependencies": [
    ".oxlintrc.json",
    "tsconfig*.json",
    "pnpm-workspace.yaml"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!**/*.spec.ts",
        "!vitest.config*.ts",
        "!*.md",
        "!**/*.test.ts",
        "!**/*.test.tsx"
      ],
      "outputs": ["dist/**", ".bundle-analysis/**", "*.tsbuildinfo"],
      "env": ["GIT_SHA", "VITE_*"]
    },
    "size": {
      "dependsOn": ["build"],
      "inputs": ["dist/**", ".size-limit.json"]
    },
    "lighthouse": {
      "dependsOn": ["build"],
      "cache": false
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#client:generate": {
      "dependsOn": ["@nestjs-monorepo-template/api#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "apps/api/**",
        "packages/api-client/**"
      ],
      "outputs": [
        "packages/api-client/openapi.json",
        "packages/api-client/src/schema.ts",
        "packages/api-client/src/realtime-events.ts"
      ]
    },
    "test:browser": {
      "dependsOn": [
        "@nestjs-monorepo-template/api#build",
        "@nestjs-monorepo-template/web#build"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "REDIS_URL",
        "TEST_DATABASE_URL",
        "PGPASSWORD",
        "TEST_LOGS",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "OTEL_BSP_SCHEDULE_DELAY",
        "SENTRY_DSN"
      ]
    },
    "test:cov": {
      "dependsOn": ["^build"],
      "outputs": [".vitest/**", "coverage/**"]
    }
  },
  "globalEnv": ["CI", "NODE_ENV"]
}
