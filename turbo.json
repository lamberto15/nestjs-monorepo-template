{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "cacheDir": ".turbo/cache",
  "globalDependencies": [".oxlintrc.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!test/**",
        "!**/*.spec.ts",
        "!vitest.config*.ts",
        "!*.md"
      ],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "REDIS_URL",
        "TEST_DATABASE_URL",
        "PGPASSWORD",
        "TEST_LOGS"
      ]
    }
  }
}
